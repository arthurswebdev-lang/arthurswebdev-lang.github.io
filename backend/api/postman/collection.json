        {
          "name": "Create basic task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create basic -> 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "  const task = pm.response.json();",
                  "  pm.collectionVariables.set('taskId', task.id);",
                  "  pm.test('server assigned a uuid and createdAt', function () {",
                  "    pm.expect(task.id).to.match(/^[0-9a-f-]{36}$/);",
                  "    pm.expect(task.createdAt).to.be.a(\"string\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"BASIC\",\n  \"name\": \"buy milk\",\n  \"subtasks\": [\n    {\n      \"name\": \"oat milk\"\n    },\n    {\n      \"name\": \"check expiry\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{host}}/tasks",
              "host": [
                "{{host}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Simplest task. `status` defaults to TODO and `subtasks` to []; each subtask gets its own uuid."
          },
          "response": []
        },
        {
          "name": "Create event task (due in 1 minute)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Due one minute from now, so the poller picks it up on its next pass.",
                  "pm.collectionVariables.set('eventDate', new Date(Date.now() + 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create event -> 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "  const task = pm.response.json();",
                  "  pm.collectionVariables.set('taskId', task.id);",
                  "  pm.test('server assigned a uuid and createdAt', function () {",
                  "    pm.expect(task.id).to.match(/^[0-9a-f-]{36}$/);",
                  "    pm.expect(task.createdAt).to.be.a(\"string\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"EVENT\",\n  \"name\": \"standup\",\n  \"date\": \"{{eventDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{host}}/tasks",
              "host": [
                "{{host}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Event tasks carry a date. The pre-request script sets it one minute out, so the polling service prints its notification while you watch the server log."
          },
          "response": []
        },
