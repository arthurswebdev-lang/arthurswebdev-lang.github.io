          "name": "Get health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health -> 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/health",
              "host": [
                "{{host}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Reports server and database connectivity."
          },
          "response": []
        }
      ]
    },
