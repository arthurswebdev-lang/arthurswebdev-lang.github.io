        {
          "name": "Update task (PUT, full replacement)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update -> 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"EVENT\",\n  \"name\": \"standup (updated)\",\n  \"status\": \"DONE\",\n  \"date\": \"{{eventDate}}\",\n  \"subtasks\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{host}}/tasks/{{taskId}}",
              "host": [
                "{{host}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Full replacement: send every field the task should end up with. Omitting one does not keep its old value -- it reverts to the default. `type` must match the stored task. Server-owned fields (configTaskId, passedDate) survive."
          },
          "response": []
        },
