{
  "info": {
    "name": "tasks-api",
    "description": "Local API for the tasks service.\n\nSet the `host` collection variable once and every request follows it -- it holds the\nwhole base URL (scheme, host and port), so switching environments is a one-field edit.\n\n`taskId` is filled in automatically: each create request stores the new id, and the\nget/update/delete requests read it. Run the folder top to bottom and it chains.\n\nConfigs (DAILY / REPEATED_WEEKLY / REPEATED_MONTHLY) live under /repeated-tasks and in\ntheir own JSON file. /tasks holds only BASIC and EVENT -- including the events the configs\ngenerate. Run the Tasks folder, then Repeated tasks, top to bottom.\n\nA generated event only accepts status changes -- everything else about it is edited on\nthe repeated task that produces it. The status of a config is itself fixed.\n\nNote: PUT replaces the task. The body is the full representation -- same fields and\nsame rules as the matching create request -- so anything left out falls back to its\ndefault instead of keeping its stored value. Only `id` and `createdAt` survive, and\n`type` must match the stored task; sending a different one is rejected with 400.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "configId",
      "value": "",
      "type": "string"
    },
    {
      "key": "generatedEventId",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventDate",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
