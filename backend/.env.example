# Local environment. Values here are the defaults the app falls back to anyway,
# so an untouched file changes nothing — edit what you need.
# A variable already set in your shell wins over this file.

# HTTP port the server listens on. 0-65535.
PORT=3000

# development | production
NODE_ENV=development


# How often the event poller looks for tasks that just came due, in ms.
# Minimum 100. Lower it to watch notifications fire without waiting a minute.
POLL_INTERVAL_MS=60000

# MongoDB connection string. On fly.io this is set with `fly secrets set`.
MONGO_URL=mongodb://127.0.0.1:27017

# Database the collections live in.
MONGO_DB_NAME=todo-list

# Origins allowed to call the API, comma separated. '*' allows any.
ORIGIN=*

# Firebase service-account key, for sending push notifications. Either the raw
# JSON from the Firebase console (Project settings > Service accounts >
# Generate new private key) or base64 of it — fly.io secrets are single-line,
# so base64 is easier there:
#   fly secrets set FIREBASE_SERVICE_ACCOUNT="$(base64 -i service-account.json)"
# Leave this unset and due events are logged instead of pushed; everything else
# in the API works exactly the same.
FIREBASE_SERVICE_ACCOUNT=

# Where a tapped notification opens — the GitHub Pages URL of the PWA.
# Unset means the notification is not clickable through to the app.
APP_URL=
